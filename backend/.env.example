# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# Port the API server listens on
PORT=5000

# PostgreSQL connection string.
# Local development points at the Docker Postgres from docker-compose.yml.
DATABASE_URL="postgresql://teamops:teamops@localhost:5432/teamops?schema=public"

# Secret used to sign JWT authentication tokens. Use a long random value.
JWT_SECRET="change-me-to-a-long-random-string"
